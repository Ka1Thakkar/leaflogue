---
import Search from 'virtual:starlight/components/Search';
import ThemePicker from './ThemePicker';
---
<div class="salon-masthead">
  <a class="salon-brand" href="/"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5 19C5 10 10 5 20 5c0 10-5 15-14 15M5 19l8-8" />
  </svg><span translate="no">Leaflogue</span></a>
  <div class="salon-search"><Search /></div>
  <nav aria-label="Main"><a href="/#catalogue">Features</a><a href="https://github.com/Ka1Thakkar/leaflogue" target="_blank" rel="noopener noreferrer" aria-label="Source code on GitHub" title="Source code on GitHub"><svg class="salon-nav-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
  <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z" />
</svg></a></nav>
  <a class="salon-download" href="https://github.com/Ka1Thakkar/leaflogue/releases" target="_blank" rel="noopener noreferrer" aria-label="Download Leaflogue" title="Download Leaflogue"><svg class="salon-nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5"/></svg></a>
  <ThemePicker client:load compact />
</div>
<style>
.salon-masthead { display:flex; align-items:center; gap:24px; max-width:1344px; height:100%; margin:auto; color:var(--red-ink); }
.salon-brand { font:400 27px/1 var(--display); text-decoration:none; white-space:nowrap; }
.salon-brand small { font:600 10px/1 var(--sans); text-transform:uppercase; letter-spacing:.14em; margin-left:12px; }
.salon-search { margin-left:auto; width:min(360px,30vw); }
nav { display:flex; gap:22px; font:500 13px/1 var(--sans); }
nav a { color:inherit; text-decoration:none; }
.salon-download { padding:9px 18px; border:1px solid var(--line); border-radius:999px; font-size:13px; text-decoration:none; }
@media(max-width:1000px) { nav { display:none; } .salon-masthead { gap:14px; } }
@media(max-width:600px) { .salon-brand { font-size:23px; } .salon-brand small,.salon-download { display:none; } .salon-search { width:auto; } .salon-masthead { gap:12px; } }
</style>
