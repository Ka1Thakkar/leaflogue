<!doctype html>
<html lang="en-GB"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Leaflogue | A gallery for your reading</title><meta name="description" content="A free, open-source home for book highlights and notes. Collect your passages, follow your thoughts, and keep your library on your own computer." /><link rel="icon" href="/favicon.svg" />
<script is:inline>try { const theme = localStorage.getItem("starlight-theme"); if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme; } catch {}</script>
</head><body><div class="salon"><a class="skip" href="#main">Skip to content</a>

<main id="main">
<!-- ——— Room I: the red room. The hang. ——— -->
<section class="room room-red hang" aria-labelledby="title">
  <div class="wrap">
    <header class="top">
      <a class="mark" href="/"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
