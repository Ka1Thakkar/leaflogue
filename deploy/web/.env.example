# The address readers open. Must be https (http only for localhost).
LEAFLOGUE_PUBLIC_URL=https://reading.example.com
# A Google OAuth client for a web application, with
# <LEAFLOGUE_PUBLIC_URL>/auth/callback as its redirect URI.
LEAFLOGUE_OIDC_CLIENT_ID=
LEAFLOGUE_OIDC_CLIENT_SECRET=
# Who may sign in, comma-separated.
AUTH_ALLOWED_EMAILS=you@example.com
# The database password (used by both services).
POSTGRES_PASSWORD=
# Optional: a Gemini key for the AI companion.
# GEMINI_API_KEY=
