# Leaflogue server / self-hosted web variable reference.
# Copy the server values to .env only for the server application. This local file
# does not configure a Convex deployment. The desktop works without this file; optional
# sync credentials come from its process environment or permission-protected
# config file, never renderer UI fields.

NODE_ENV=development
LEAFLOGUE_PUBLIC_ORIGIN=http://localhost:3000
LEAFLOGUE_BIND_HOST=127.0.0.1
LEAFLOGUE_PORT=3000

# Required for the server. Never expose this through a VITE_ or PUBLIC_ variable.
DATABASE_URL=postgresql://leaflogue:change-me@localhost:5432/leaflogue
LEAFLOGUE_SESSION_SECRET=replace-with-at-least-32-random-bytes

# none | password | google
# `none` is rejected when the server binds to a non-loopback interface.
LEAFLOGUE_AUTH_MODE=none

# Required only when LEAFLOGUE_AUTH_MODE=google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated exact addresses; leave empty to allow every authenticated
# Google account on a general self-hosted deployment.
LEAFLOGUE_ALLOWED_EMAILS=

# Convex's current key-only desktop backend registers no OIDC provider.
# Its future-web authenticated wrappers remain closed. Do not set OIDC issuer
# variables expecting to enable them; that requires a future web-auth release.

# AI remains unavailable unless explicitly enabled. Provider keys are server-only.
LEAFLOGUE_AI_ENABLED=false
# openai | anthropic | gemini | mistral | xai | deepseek | openai-compatible
LEAFLOGUE_AI_PROVIDER=openai
LEAFLOGUE_AI_BASE_URL=
LEAFLOGUE_AI_MODEL=
LEAFLOGUE_AI_API_KEY=
# JSON provider/model catalog file mounted only into the server process.
LEAFLOGUE_AI_CATALOG_FILE=

# Optional metadata enrichment. Imports and manual books work without this.
GOOGLE_BOOKS_API_KEY=
